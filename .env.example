# Bunnyhole configuration reference: every name the key vault accepts, plus the env-only BUNNYHOLE_* settings.
#
# IMPORTANT: .env files are NOT loaded automatically. Bunnyhole does not read this file or any ./.env
# (python-dotenv is not used). Configure keys in one of two ways:
#   1. bunnyhole keys --set NAME=VALUE      (stores it in $BUNNYHOLE_HOME/api_keys.env, chmod 600;
#                                            `bunnyhole keys --set NAME=` clears it; `bunnyhole keys` lists them)
#   2. export NAME=VALUE                    (in your shell; an exported variable always wins over the vault)
# The vault is read (and exported into that process) whenever the arsenal manager is built: at the start of
# every investigation (`trace`, `intake`, `link`, `council`, `menu` traces, TUI/web/MCP runs, all of which
# construct the OSINT agent), by `darkweb`, `keys`, `doctor`/`arsenal`, the TUI Arsenal tab and the API/MCP
# arsenal endpoints. `jet`, `doc-forensics`, `cases`, `profile`, `personas` and `pi` do not read it.
# The legacy ~/.osint-apis/api_keys.env is read (merged under the vault) but never written.
#
# Every key is OPTIONAL: Bunnyhole degrades to keyless public endpoints when a key is absent.
# Keys marked (reserved) are accepted and stored but not read by any agent yet.

# --- AI synthesis & LLM Council (OpenRouter powers the multi-model Council) ---
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Breach / infostealer intelligence ---
LEAKCHECK_API_KEY=
HAVEIBEENPWNED_API_KEY=       # (reserved)
INTELX_API_KEY=               # (reserved)
HUDSONROCK_API_KEY=           # (reserved) the keyless Cavalier endpoints are used instead
BREACHDIRECTORY_API_KEY=      # (reserved)

# --- Infrastructure / network recon ---
CENSYS_API_ID=
CENSYS_API_SECRET=
SECURITYTRAILS_API_KEY=
URLSCAN_API_KEY=
ALIENVAULT_OTX_API_KEY=
SHODAN_API_KEY=               # (reserved) the keyless Shodan InternetDB is used instead
VIRUSTOTAL_API_KEY=           # (reserved)
ABUSEIPDB_API_KEY=            # (reserved)

# --- Identity / email / phone ---
GITHUB_API_KEY=
HUNTER_API_KEY=
EMAILREP_API_KEY=
NUMVERIFY_API_KEY=
IPINFO_TOKEN=                 # (reserved)
TELEGRAM_BOT_TOKEN=           # (reserved)

# --- Corporate registries, sanctions, courts ---
UK_COMPANIES_HOUSE_API_KEY=
# COMPANIES_HOUSE_API_KEY=    # accepted alias of UK_COMPANIES_HOUSE_API_KEY (the vault stores the UK_ name)
OPENSANCTIONS_API_KEY=
OPENSANCTIONS_API_URL=        # base URL of a self-hosted yente (keyless); default https://api.opensanctions.org
COURTLISTENER_API_TOKEN=
FEC_API_KEY=                  # (reserved)
OPENCORPORATES_API_KEY=       # (reserved)

# --- On-chain explorers ---
ETHERSCAN_API_KEY=            # (reserved) Blockscout v2 is used keyless
HELIUS_API_KEY=               # (reserved)

# --- Env-only BUNNYHOLE_* settings (NOT stored by `keys --set`; export them in your shell) ---
# Relocate all state (key vault, cases.db, profile.json). Default ~/.bunnyhole.
# BUNNYHOLE_HOME=/path/to/bunnyhole-state
# Route all outbound traffic through a proxy without passing --proxy each time.
# BUNNYHOLE_PROXY=socks5h://127.0.0.1:9050
# Point --tor and .onion fetches at a non-default Tor SOCKS listener (default socks5h://127.0.0.1:9050).
# BUNNYHOLE_TOR_PROXY=socks5h://127.0.0.1:9050
# Bearer token for the web/API server. REQUIRED to `bunnyhole serve --host` on a non-loopback address.
# BUNNYHOLE_API_TOKEN=
# SEC EDGAR asks for a contact User-Agent ("Name email@example.com"); also sent to the PI public-record sources.
# BUNNYHOLE_SEC_USER_AGENT=
# LLM model ids (each has a built-in default).
# BUNNYHOLE_ANTHROPIC_MODEL=
# BUNNYHOLE_ANTHROPIC_FAST_MODEL=
# BUNNYHOLE_OPENAI_MODEL=
# BUNNYHOLE_GEMINI_MODEL=
# Web/API server (`bunnyhole serve`) limits and switches (defaults shown).
# BUNNYHOLE_MAX_ACTIVE_CASES=50
# BUNNYHOLE_MAX_CONCURRENT=4
# BUNNYHOLE_API_MAX_QUEUED=16
# BUNNYHOLE_MAX_RAW_TEXT=20000
# BUNNYHOLE_MAX_SELECTORS=64
# BUNNYHOLE_API_MAX_BODY=1048576
# BUNNYHOLE_API_INVESTIGATION_TIMEOUT_S=900
# BUNNYHOLE_API_MAX_EVIDENCE_BYTES=26214400
# Local .pdf/.docx evidence over HTTP is off unless this directory is set (paths must be inside it).
# BUNNYHOLE_EVIDENCE_DIR=
# POST /api/arsenal/install is off unless this is 1 AND BUNNYHOLE_API_TOKEN is set.
# BUNNYHOLE_API_ALLOW_INSTALL=0
# MCP server (`bunnyhole mcp`): concurrent long-running tools and per-call wall-clock limit (defaults shown).
# BUNNYHOLE_MCP_MAX_CONCURRENT=2
# BUNNYHOLE_MCP_TOOL_TIMEOUT_S=900
